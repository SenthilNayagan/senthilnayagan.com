---
stylesheets:
  - /assets/styles/main.css
scripts: []
---
{%- comment -%}Global variables for reuse in meta tags{%- endcomment -%}
{%- if page.url == "/" -%}
  {%- assign pageTitle = site.title -%}
{%- else -%}
  {%- assign pageTitle = title | default: renderData.title | append: " | " | append: site.shortTitle -%}
{%- endif -%}
{%- assign description = description | default: site.description -%}
{%- assign keywords = keywords | default: site.keywords -%}
{%- comment -%}Canonical URL. Make sure each page has one.{%- endcomment -%}
{%- assign canonicalUrl = page.url | toAbsoluteUrl -%}
{%- comment -%}
  Content worth surfacing in search (posts, About, Newsletter) vs. pages that just list/aggregate that
  content (home, /blog/, /tags/, pagination) — see the eleventy.after hook in .eleventy.js for how this
  attribute controls what Pagefind indexes.
{%- endcomment -%}
{%- assign isSearchable = false -%}
{%- if tags contains "posts" or page.url == "/about/" or page.url == "/newsletter/" -%}
  {%- assign isSearchable = true -%}
{%- endif -%}

<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
  {%- comment -%}Must appear in the first 1024 bytes: https://web.dev/charset/{%- endcomment -%}
  <meta charset="utf-8">
  {%- comment -%}Set the theme before first paint to avoid a flash of the wrong theme{%- endcomment -%}
  <script>
    (function () {
      try {
        var stored = localStorage.getItem('theme');
        var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    })();
  </script>
  {%- comment -%}Preload the body font to avoid a flash of unstyled/fallback text{%- endcomment -%}
  <link rel="preload" href="/assets/fonts/source-sans-3-variable-latin-normal.woff2" as="font" type="font/woff2" crossorigin>
  {%- comment -%}Metadata for search engines{%- endcomment -%}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="keywords" content="{{ keywords | join: ', ' }}">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="author" content="{{ site.author }}">
  <link rel="canonical" href="{{ canonicalUrl }}">
  {%- if noindex -%}
    <meta name="robots" content="noindex">
  {%- endif -%}
  {%- comment -%}Global and page/layout-specific CSS{%- endcomment -%}
  {%- for href in stylesheets -%}
    <link rel="stylesheet" href="{{ href }}">
  {%- endfor -%}
  {%- comment -%}Template-specific module scripts, deferred by default{%- endcomment -%}
  {%- for script in scripts -%}
    <script type="module" src="{{ script }}"></script>
  {%- endfor -%}
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="{{ '/feed.xml' | toAbsoluteUrl }}">
  {%- comment -%}Favicons{%- endcomment -%}
  {% favicon 'src/assets/images/favicon/favicon.png' %}
  {%- comment -%}Open Graph meta tags{%- endcomment -%}
  <meta property="og:title" content="{{ openGraph.title | default: pageTitle }}">
  {%- if openGraph.image -%}
    <meta property="og:image" content="{{ openGraph.image | toAbsoluteUrl }}">
  {%- endif -%}
  <meta property="og:description" content="{{ openGraph.description | default: description }}">
  <meta property="og:url" content="{{ page.url | toAbsoluteUrl }}">
  <meta property="og:type" content="{{ openGraph.type | default: "website" }}">
  <meta property="og:locale" content="{{ site.language | replace: "-", "_" }}">
  {%- comment -%}Twitter card meta tags{%- endcomment -%}
  <meta name="twitter:card" content="{{ openGraph.twitter.card | default: "summary" }}">
  <meta name="twitter:title" content="{{ openGraph.title | default: pageTitle }}">
  <meta name="twitter:description" content="{{ openGraph.description | default: description }}">
  {%- if openGraph.image -%}
    <meta name="twitter:image" content="{{ openGraph.image | toAbsoluteUrl }}">
  {%- endif -%}
  {%- comment -%}Preload optimizations{%- endcomment -%}
  {%- if preloads -%}
  {% for preload in preloads %}
    <link rel="preload" as="{{ preload.as }}" type="{{ preload.type }}" href="{{ preload.href }}" {% if preload.crossorigin %}crossorigin{% endif %}>
  {%- endfor -%}
  {% endif %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "components/header.liquid" %}
  <main id="main"{% if isSearchable %} data-pagefind-body{% endif %}>
    {{ content }}
  </main>
  {% include "components/footer.liquid" %}
  {% include "components/search.liquid" %}
  <button type="button" id="back-to-top" class="back-to-top" aria-label="Back to top">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="12" y1="19" x2="12" y2="5"></line>
      <polyline points="5 12 12 5 19 12"></polyline>
    </svg>
  </button>
  <script type="module" src="/assets/scripts/theme-toggle.js"></script>
  <script type="module" src="/assets/scripts/back-to-top.js"></script>
  <script type="module" src="/assets/scripts/search.js"></script>
</body>
</html>

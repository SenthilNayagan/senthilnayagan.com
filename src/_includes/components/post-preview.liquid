<article class="post-preview">
  <div class="post-preview__meta">
    <time datetime="{{ post.date | machineDate }}">{{ post.date | readableDate }}</time>
    <span aria-hidden="true">&middot;</span>
    <span>{{ post.templateContent | readingTime }} min read</span>
  </div>
  <h2 class="post-preview__title"><a href="{{ post.url }}" style="view-transition-name: view-{{ post.fileSlug }};">{{ post.data.title }}</a></h2>
  {%- if post.data.description -%}
  <p class="post-preview__excerpt">{{ post.data.description }}</p>
  {%- endif -%}
  {%- assign postTags = post.data.tags | publicTags -%}
  {%- if postTags.size > 0 -%}
  <ul class="tag-list">
    {%- for tag in postTags -%}
    <li><a class="tag" href="/tags/{{ tag | slugify }}/">{{ tag }}</a></li>
    {%- endfor -%}
  </ul>
  {%- endif -%}
</article>

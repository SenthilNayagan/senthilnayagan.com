{%- comment -%}
  Reusable Previous/Next navigation for CCAR-F Learning Path articles. Reads `learningPath` (an
  object with step, total, previousTitle/previousUrl, nextTitle/nextUrl — any of the four may be
  blank/omitted) and `title` (the current post's own title) from the including page's front
  matter. Pass `position: "top"` for the compact step-indicator callout, or omit it (or pass
  `position: "bottom"`) for the fuller "Continue the Learning Path" block. Renders nothing on a
  page with no `learningPath` front matter.
{%- endcomment -%}
{%- if learningPath -%}
  {%- if position == "top" -%}
<aside role="note" class="post-aside learning-path-nav learning-path-nav--top"><p class="learning-path-nav__label">CCAR-F Learning Path</p><p class="learning-path-nav__step">Step {{ learningPath.step }} of {{ learningPath.total }} &middot; {{ title }}</p><p class="learning-path-nav__links"><a href="/blog/ccar-f-learning-path/" target="_blank" rel="noopener">Learning Path</a>{%- if learningPath.previousUrl and learningPath.previousUrl != "" %} &middot; Previous: <a href="{{ learningPath.previousUrl }}">{{ learningPath.previousTitle }}</a>{%- endif -%}{%- if learningPath.nextTitle and learningPath.nextTitle != "" %} &middot; Next: {% if learningPath.nextUrl and learningPath.nextUrl != "" %}<a href="{{ learningPath.nextUrl }}">{{ learningPath.nextTitle }}</a>{%- else %}{{ learningPath.nextTitle }} <span class="learning-path-nav__soon">(coming soon)</span>{%- endif -%}{%- endif -%}</p></aside>
  {%- else -%}
<nav class="learning-path-nav learning-path-nav--bottom" aria-label="Learning path navigation"><p class="learning-path-nav__heading">Continue the Learning Path</p><p class="learning-path-nav__links">{%- if learningPath.previousUrl and learningPath.previousUrl != "" %}&larr; Previous: <a href="{{ learningPath.previousUrl }}"><strong>{{ learningPath.previousTitle }}</strong></a><span class="learning-path-nav__sep" aria-hidden="true">|</span>{%- endif -%}<a href="/blog/ccar-f-learning-path/" target="_blank" rel="noopener">CCAR-F Learning Path</a>{%- if learningPath.nextTitle and learningPath.nextTitle != "" %}<span class="learning-path-nav__sep" aria-hidden="true">|</span>{%- if learningPath.nextUrl and learningPath.nextUrl != "" %}Next: <a href="{{ learningPath.nextUrl }}"><strong>{{ learningPath.nextTitle }} &rarr;</strong></a>{%- else %}Next: <strong>{{ learningPath.nextTitle }} &rarr;</strong> <span class="learning-path-nav__soon">(coming soon)</span>{%- endif -%}{%- endif -%}</p></nav>
  {%- endif -%}
{%- endif -%}

{
  "name": "senthilnayagan.com",
  "description": "Senthil Nayagan's personal tech blog.",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "private": true,
  "author": "Senthil Nayagan",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rimraf _site .cache",
    "dev": "npm-run-all clean --parallel dev:*",
    "dev:html": "cross-env ELEVENTY_ENV=development eleventy --serve --incremental --port=8080",
    "dev:css": "sass --watch src/assets/styles:_site/assets/styles --style=expanded --source-map",
    "build": "npm-run-all clean build:css build:html",
    "build:html": "cross-env ELEVENTY_ENV=production eleventy",
    "build:css": "sass src/assets/styles:_site/assets/styles --style=compressed --no-source-map",
    "lint": "npm-run-all lint:*",
    "lint:js": "eslint --cache --fix \"**/*.js\"",
    "lint:css": "stylelint --fix \"src/**/*.scss\"",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "luxon": "^3.7.2",
    "markdown-it-anchor": "^9.2.1",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^16.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "sass": "^1.102.0",
    "stylelint": "^16.14.1",
    "stylelint-config-standard-scss": "^15.0.0"
  },
  "browserslist": [
    "last 2 chrome versions",
    "last 2 firefox versions",
    "last 2 safari versions",
    "last 2 edge versions"
  ]
}
